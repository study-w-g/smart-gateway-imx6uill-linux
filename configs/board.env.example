# Copy to configs/board.env and fill in local paths.
# The completed board.env is ignored by Git.

BOARD_NAME=imx6u-alpha-v2.2
ARCH=arm
CROSS_COMPILE=arm-linux-gnueabihf-

# Local vendor BSP locations. Do not commit these directories.
UBOOT_DIR=external/u-boot-atk
KERNEL_DIR=external/linux-atk
ROOTFS_DIR=external/buildroot-or-busybox

# Output and deployment settings
OUT_DIR=out/imx6u-alpha-v2.2
TFTP_DIR=/srv/tftp
NFS_ROOT=/srv/nfs/imx6u-alpha-v2.2
KERNEL_IMAGE=zImage
DTB_NAME=TODO-confirm-from-vendor-BSP.dtb

# Keep these empty until the actual board wiring and boot medium are confirmed.
SERIAL_DEVICE=
TFTP_SERVER_IP=
BOARD_IP=
